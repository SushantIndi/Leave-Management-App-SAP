{
  "xsappname": "leave-app-cap",
  "tenant-mode": "dedicated",

  "scopes": [
    {
      "name": "$XSAPPNAME.Employee",
      "description": "Employee role"
    },
    {
      "name": "$XSAPPNAME.Manager",
      "description": "Manager role"
    }
  ],

  "role-templates": [
    {
      "name": "Employee",
      "description": "Employee access",
      "scope-references": [
        "$XSAPPNAME.Employee"
      ]
    },
    {
      "name": "Manager",
      "description": "Manager access",
      "scope-references": [
        "$XSAPPNAME.Manager"
      ]
    }
  ]
}